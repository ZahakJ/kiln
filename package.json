{
  "name": "kiln",
  "version": "0.1.0",
  "private": true,
  "description": "Kiln: an open-source office suite (Kiln Write, Kiln Grid, Kiln Deck, Kiln Notes) with a Rust core, for Linux, Windows, macOS, Android and the web.",
  "license": "AGPL-3.0-or-later",
  "author": "ZahakJ",
  "homepage": "https://zahakj.github.io/kiln/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZahakJ/kiln.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@kiln/web",
    "build": "turbo run build --filter=!@kiln/desktop",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e --filter=@kiln/e2e --",
    "verify": "turbo run lint typecheck test",
    "format": "biome format --write .",
    "tauri": "pnpm --filter @kiln/desktop exec tauri",
    "licenses:check": "node tools/check-licenses.mjs",
    "licenses:notices": "cargo xtask notices",
    "media:render": "node tools/render-media.mjs",
    "parity": "cargo xtask parity",
    "parity:verify": "cargo xtask parity --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "numfmt": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
