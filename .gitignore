# Rust build output (shared by both agents; never `cargo clean` it, PLAN.md §4.1)
target/

# Dependencies and build output
node_modules/
dist/
out/
.turbo/
*.tsbuildinfo
coverage/

# wasm-bindgen output generated by `cargo xtask wasm`
