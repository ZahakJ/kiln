fixtures/xlsx/large/

# Android build dirs (the generated Gradle project itself is committed)
apps/desktop/src-tauri/gen/android/app/build/
apps/desktop/src-tauri/gen/android/build/
apps/desktop/src-tauri/gen/android/.gradle/
apps/desktop/src-tauri/gen/android/local.properties
.gradle/
*.apk
*.aab
*.jks
*.keystore

