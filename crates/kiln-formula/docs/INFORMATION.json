  {
    "name": "TYPE",
    "category": "Information",
    "summary": "Returns a number for the data type of a value (1 number, 2 text, 4 logical, 16 error, 64 array, 128 lambda).",
    "syntax": "TYPE(value)",
    "args": [
      {
        "name": "value",
        "description": "The value to test."
      }
    ],
    "examples": [
      {
        "formula": "=TYPE(2)",
        "result": "1"
      },
      {
        "formula": "=TYPE(\"a\")",
        "result": "2"
      },
      {
        "formula": "=TYPE(TRUE)",
        "result": "4"
      },
      {
        "formula": "=TYPE(1/0)",
        "result": "16"
      },
      {
        "formula": "=TYPE({1,2})",
        "result": "64"
      }
    ],
    "since": "2007"
  }
