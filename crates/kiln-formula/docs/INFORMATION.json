[
  {
    "name": "CELL",
    "category": "Information",
    "summary": "Returns information about the formatting, location or contents of a cell (address, col, row, contents, type, filename).",
    "syntax": "CELL(info_type, [reference])",
    "args": [
      {
        "name": "info_type",
        "description": "\"address\", \"col\", \"row\", \"contents\", \"type\" or \"filename\"."
      },
      {
        "name": "reference",
        "description": "The cell (default: the formula cell).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=CELL(\"row\",C7)",
        "result": "7"
      },
      {
        "formula": "=CELL(\"address\",C7)",
        "result": "\"$C$7\""
      },
      {
        "formula": "=CELL(\"type\",C7)",
        "result": "\"b\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "ERROR.TYPE",
    "category": "Information",
    "summary": "Returns a number for an error value (1 #NULL!, 2 #DIV/0!, 3 #VALUE!, 4 #REF!, 5 #NAME?, 6 #NUM!, 7 #N/A …).",
    "syntax": "ERROR.TYPE(error_val)",
    "args": [
      {
        "name": "error_val",
        "description": "The error to identify."
      }
    ],
    "examples": [
      {
        "formula": "=ERROR.TYPE(1/0)",
        "result": "2"
      },
      {
        "formula": "=ERROR.TYPE(NA())",
        "result": "7"
      },
      {
        "formula": "=ERROR.TYPE(1)",
        "result": "#N/A"
      }
    ],
    "since": "2007"
  },
  {
    "name": "FORMULATEXT",
    "category": "Lookup & Reference",
    "summary": "Returns the formula of a cell as text.",
    "syntax": "FORMULATEXT(reference)",
    "args": [
      {
        "name": "reference",
        "description": "A cell."
      }
    ],
    "examples": [
      {
        "formula": "=FORMULATEXT(A1)",
        "result": "#N/A"
      }
    ],
    "since": "2013"
  },
  {
    "name": "INFO",
    "category": "Information",
    "summary": "Returns information about the operating environment (numfile, recalc, release, system, osversion, origin).",
    "syntax": "INFO(type_text)",
    "args": [
      {
        "name": "type_text",
        "description": "The kind of information."
      }
    ],
    "examples": [
      {
        "formula": "=INFO(\"recalc\")",
        "result": "\"Automatic\""
      },
      {
        "formula": "=INFO(\"numfile\")",
        "result": "1"
      }
    ],
    "since": "2007"
  },
