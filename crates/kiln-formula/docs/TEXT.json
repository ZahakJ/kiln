        "formula": "=LEFT(\"Offering\",3)",
        "result": "\"Off\""
      },
      {
        "formula": "=LEFT(\"Sweden\")",
        "result": "\"S\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "LEFTB",
    "category": "Text",
    "summary": "Returns the first characters of a text string (bytes in double-byte languages).",
