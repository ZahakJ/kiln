    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "num_bytes",
        "description": "How many (default 1).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=LEFTB(\"Offering\",3)",
        "result": "\"Off\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "LEN",
    "category": "Text",
