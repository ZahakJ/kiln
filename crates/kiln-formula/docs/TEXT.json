      }
    ],
    "since": "2007"
  },
  {
    "name": "SEARCH",
    "category": "Text",
    "summary": "Finds one text string within another (not case-sensitive, wildcards allowed) and returns its position.",
    "syntax": "SEARCH(find_text, within_text, [start_num])",
    "args": [
      {
        "name": "find_text",
        "description": "The text to find (? and * are wildcards, ~ escapes)."
      },
      {
        "name": "within_text",
        "description": "The text to search."
      },
      {
        "name": "start_num",
        "description": "The character to start at (default 1).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=SEARCH(\"e\",\"Statements\",6)",
        "result": "7"
      },
      {
        "formula": "=SEARCH(\"margin\",\"Profit Margin\")",
        "result": "8"
      },
      {
        "formula": "=SEARCH(\"p?o\",\"Profit\")",
        "result": "1"
      }
    ],
    "since": "2007"
  },
  {
    "name": "SEARCHB",
    "category": "Text",
    "summary": "Finds one text string within another (byte positions in double-byte languages).",
    "syntax": "SEARCHB(find_text, within_text, [start_num])",
    "args": [
      {
        "name": "find_text",
        "description": "The text to find."
      },
      {
        "name": "within_text",
        "description": "The text to search."
      },
      {
        "name": "start_num",
        "description": "The character to start at.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=SEARCHB(\"margin\",\"Profit Margin\")",
        "result": "8"
      }
    ],
    "since": "2007"
  },
  {
    "name": "SUBSTITUTE",
    "category": "Text",
    "summary": "Substitutes new text for old text in a text string.",
    "syntax": "SUBSTITUTE(text, old_text, new_text, [instance_num])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "old_text",
        "description": "The text to replace."
      },
      {
        "name": "new_text",
        "description": "The replacement."
      },
      {
        "name": "instance_num",
        "description": "Which occurrence to replace (default: all).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=SUBSTITUTE(\"Sales Data\",\"Sales\",\"Cost\")",
        "result": "\"Cost Data\""
      },
      {
        "formula": "=SUBSTITUTE(\"Quarter 1, 2008\",\"1\",\"2\",1)",
        "result": "\"Quarter 2, 2008\""
      },
      {
        "formula": "=SUBSTITUTE(\"Quarter 1, 2011\",\"1\",\"2\",3)",
        "result": "\"Quarter 1, 2012\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "T",
    "category": "Text",
    "summary": "Returns the text referred to by a value, or \"\" for non-text.",
    "syntax": "T(value)",
    "args": [
      {
        "name": "value",
        "description": "The value to test."
      }
    ],
    "examples": [
      {
        "formula": "=T(\"Rainfall\")",
        "result": "\"Rainfall\""
      },
      {
        "formula": "=T(19)",
        "result": "\"\""
      },
      {
        "formula": "=T(TRUE)",
        "result": "\"\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "TEXT",
    "category": "Text",
    "summary": "Formats a number and converts it to text using a number format code.",
    "syntax": "TEXT(value, format_text)",
    "args": [
      {
        "name": "value",
        "description": "The number to format."
      },
      {
        "name": "format_text",
        "description": "A number format such as \"#,##0.00\", \"0%\", \"yyyy-mm-dd\" or \"h:mm AM/PM\"."
      }
    ],
    "examples": [
      {
        "formula": "=TEXT(1234.5,\"#,##0.00\")",
        "result": "\"1,234.50\""
      },
      {
        "formula": "=TEXT(0.285,\"0.0%\")",
        "result": "\"28.5%\""
      },
      {
        "formula": "=TEXT(45306,\"yyyy-mm-dd\")",
        "result": "\"2024-01-15\""
      },
      {
        "formula": "=TEXT(45306,\"dddd, mmmm d\")",
        "result": "\"Monday, January 15\""
      },
      {
        "formula": "=TEXT(0.75,\"h:mm AM/PM\")",
        "result": "\"6:00 PM\""
      },
      {
        "formula": "=TEXT(1234567,\"0.00E+00\")",
        "result": "\"1.23E+06\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "TEXTAFTER",
    "category": "Text",
    "summary": "Returns text that occurs after a given delimiter.",
    "syntax": "TEXTAFTER(text, delimiter, [instance_num], [match_mode], [match_end], [if_not_found])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "delimiter",
        "description": "The text that marks the point after which to extract."
      },
      {
        "name": "instance_num",
        "description": "Which occurrence (negative counts from the end; default 1).",
        "optional": true
      },
      {
        "name": "match_mode",
        "description": "1 for case-insensitive.",
        "optional": true
      },
      {
        "name": "match_end",
        "description": "1 treats the end of the text as a delimiter.",
        "optional": true
      },
      {
        "name": "if_not_found",
        "description": "Returned when there is no match (default #N/A).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=TEXTAFTER(\"Little Red Riding Hood's red hood\",\"Red\")",
        "result": "\" Riding Hood's red hood\""
      },
      {
        "formula": "=TEXTAFTER(\"Little Red Riding Hood's red hood\",\"red\",2,1)",
        "result": "\" hood\""
      },
      {
        "formula": "=TEXTAFTER(\"Little Red Riding Hood's red hood\",\"basket\",1,0,0,\"x\")",
        "result": "\"x\""
      }
    ],
    "since": "2024"
  },
  {
    "name": "TEXTBEFORE",
    "category": "Text",
    "summary": "Returns text that occurs before a given delimiter.",
    "syntax": "TEXTBEFORE(text, delimiter, [instance_num], [match_mode], [match_end], [if_not_found])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "delimiter",
        "description": "The text that marks the point before which to extract."
      },
      {
        "name": "instance_num",
        "description": "Which occurrence (negative counts from the end; default 1).",
        "optional": true
      },
      {
        "name": "match_mode",
        "description": "1 for case-insensitive.",
        "optional": true
      },
      {
        "name": "match_end",
        "description": "1 treats the end of the text as a delimiter.",
        "optional": true
      },
      {
        "name": "if_not_found",
        "description": "Returned when there is no match (default #N/A).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=TEXTBEFORE(\"Little Red Riding Hood's red hood\",\"Red\")",
        "result": "\"Little \""
      },
      {
        "formula": "=TEXTBEFORE(\"Little Red Riding Hood's red hood\",\"red\",-1)",
        "result": "\"Little Red Riding Hood's \""
      },
      {
        "formula": "=TEXTBEFORE(\"Little Red Riding Hood's red hood\",\"red\",1,1)",
        "result": "\"Little \""
      }
    ],
    "since": "2024"
  },
  {
    "name": "TEXTJOIN",
    "category": "Text",
    "summary": "Joins text with a delimiter, optionally skipping empty values.",
    "syntax": "TEXTJOIN(delimiter, ignore_empty, text1, [text2], ...)",
    "args": [
      {
        "name": "delimiter",
        "description": "Text placed between items."
      },
      {
        "name": "ignore_empty",
        "description": "TRUE to skip empty cells."
      },
      {
        "name": "text1",
        "description": "Text, a number or a range to join."
      },
      {
        "name": "text2",
        "description": "Further items.",
        "repeating": true,
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=TEXTJOIN(\", \",TRUE,\"a\",\"\",\"b\")",
        "result": "\"a, b\""
      },
      {
        "formula": "=TEXTJOIN(\"-\",FALSE,\"a\",\"\",\"b\")",
        "result": "\"a--b\""
      }
    ],
    "since": "2019"
  },
  {
    "name": "TEXTSPLIT",
    "category": "Text",
    "summary": "Splits text into rows and columns using delimiters.",
    "syntax": "TEXTSPLIT(text, col_delimiter, [row_delimiter], [ignore_empty], [match_mode], [pad_with])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "col_delimiter",
        "description": "Where to split into columns."
      },
      {
        "name": "row_delimiter",
        "description": "Where to split into rows.",
        "optional": true
      },
      {
        "name": "ignore_empty",
        "description": "TRUE to ignore consecutive delimiters.",
        "optional": true
      },
      {
        "name": "match_mode",
        "description": "1 for case-insensitive.",
        "optional": true
      },
      {
        "name": "pad_with",
        "description": "Value used to pad missing cells (default #N/A).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=TEXTSPLIT(\"Dakota Lennon Sanchez\",\" \")",
        "result": "{\"Dakota\",\"Lennon\",\"Sanchez\"}"
      },
      {
        "formula": "=TEXTSPLIT(\"1,2,3;4,5,6\",\",\",\";\")",
        "result": "{\"1\",\"2\",\"3\";\"4\",\"5\",\"6\"}"
      },
      {
        "formula": "=TEXTSPLIT(\"a,b;c\",\",\",\";\",FALSE,0,\"-\")",
        "result": "{\"a\",\"b\";\"c\",\"-\"}"
      }
    ],
    "since": "2024"
  },
  {
    "name": "TRIM",
    "category": "Text",
    "summary": "Removes extra spaces from text, leaving single spaces between words.",
