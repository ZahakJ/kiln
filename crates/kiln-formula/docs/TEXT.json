      }
    ],
    "examples": [
      {
        "formula": "=LENB(\"Offering\")",
        "result": "8"
      }
    ],
    "since": "2007"
  },
  {
    "name": "LOWER",
    "category": "Text",
    "summary": "Converts text to lowercase.",
    "syntax": "LOWER(text)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      }
    ],
    "examples": [
      {
        "formula": "=LOWER(\"E. E. Cummings\")",
        "result": "\"e. e. cummings\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "MID",
    "category": "Text",
    "summary": "Returns characters from the middle of a text string.",
    "syntax": "MID(text, start_num, num_chars)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "start_num",
        "description": "Position of the first character (1 is the first)."
      },
      {
        "name": "num_chars",
        "description": "How many characters."
      }
    ],
    "examples": [
      {
        "formula": "=MID(\"Fluid Flow\",1,5)",
        "result": "\"Fluid\""
      },
      {
        "formula": "=MID(\"Fluid Flow\",7,20)",
        "result": "\"Flow\""
      },
      {
        "formula": "=MID(\"Fluid Flow\",20,5)",
        "result": "\"\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "MIDB",
    "category": "Text",
    "summary": "Returns characters from the middle of a text string (bytes in double-byte languages).",
    "syntax": "MIDB(text, start_num, num_bytes)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "start_num",
        "description": "Starting position."
      },
      {
        "name": "num_bytes",
        "description": "How many."
      }
    ],
    "examples": [
      {
        "formula": "=MIDB(\"Fluid Flow\",7,4)",
        "result": "\"Flow\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "NUMBERVALUE",
    "category": "Text",
    "summary": "Converts text to a number in a locale-independent way.",
    "syntax": "NUMBERVALUE(text, [decimal_separator], [group_separator])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "decimal_separator",
        "description": "The decimal separator character.",
        "optional": true
      },
      {
        "name": "group_separator",
        "description": "The group separator character.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=NUMBERVALUE(\"2.500,27\",\",\",\".\")",
        "result": "2500.27"
      },
      {
        "formula": "=NUMBERVALUE(\"3.5%\")",
        "result": "0.035"
      }
    ],
    "since": "2013"
  },
  {
    "name": "PROPER",
    "category": "Text",
    "summary": "Capitalises the first letter of each word.",
    "syntax": "PROPER(text)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      }
    ],
    "examples": [
      {
        "formula": "=PROPER(\"this is a TITLE\")",
        "result": "\"This Is A Title\""
      },
      {
        "formula": "=PROPER(\"2-way street\")",
        "result": "\"2-Way Street\""
      },
      {
        "formula": "=PROPER(\"76BudGet\")",
        "result": "\"76Budget\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "REGEXEXTRACT",
    "category": "Text",
    "summary": "Extracts text that matches a regular expression.",
    "syntax": "REGEXEXTRACT(text, pattern, [return_mode], [case_sensitivity])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "pattern",
        "description": "The regular expression."
      },
      {
        "name": "return_mode",
        "description": "0 first match (default), 1 all matches, 2 capture groups of the first match.",
        "optional": true
      },
      {
        "name": "case_sensitivity",
        "description": "0 case-sensitive (default), 1 case-insensitive.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=REGEXEXTRACT(\"DylanWilliams\",\"[A-Z][a-z]+\")",
        "result": "\"Dylan\""
      },
      {
        "formula": "=REGEXEXTRACT(\"DylanWilliams\",\"[A-Z][a-z]+\",1)",
        "result": "{\"Dylan\";\"Williams\"}"
      }
    ],
    "since": "365"
  },
  {
    "name": "REGEXREPLACE",
    "category": "Text",
    "summary": "Replaces text that matches a regular expression.",
    "syntax": "REGEXREPLACE(text, pattern, replacement, [occurrence], [case_sensitivity])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "pattern",
        "description": "The regular expression."
      },
      {
        "name": "replacement",
        "description": "The replacement text ($1 refers to a capture group)."
      },
      {
        "name": "occurrence",
        "description": "Which match to replace (0, the default, replaces all).",
        "optional": true
      },
      {
        "name": "case_sensitivity",
        "description": "0 case-sensitive (default), 1 case-insensitive.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=REGEXREPLACE(\"Sonia Brown\",\"([A-Z])[a-z]+ ([A-Z][a-z]+)\",\"$2, $1.\")",
        "result": "\"Brown, S.\""
      },
      {
        "formula": "=REGEXREPLACE(\"a1b2c3\",\"[0-9]\",\"#\")",
        "result": "\"a#b#c#\""
      }
    ],
    "since": "365"
  },
  {
    "name": "REGEXTEST",
    "category": "Text",
    "summary": "Checks whether any part of text matches a regular expression.",
    "syntax": "REGEXTEST(text, pattern, [case_sensitivity])",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "pattern",
        "description": "The regular expression."
      },
      {
        "name": "case_sensitivity",
        "description": "0 case-sensitive (default), 1 case-insensitive.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=REGEXTEST(\"alpha\",\"[aeiou]\")",
        "result": "TRUE"
      },
      {
        "formula": "=REGEXTEST(\"rhythm\",\"[aeiou]\")",
        "result": "FALSE"
      }
    ],
    "since": "365"
  },
  {
    "name": "REPLACE",
    "category": "Text",
    "summary": "Replaces part of a text string with different text.",
    "syntax": "REPLACE(old_text, start_num, num_chars, new_text)",
    "args": [
      {
        "name": "old_text",
        "description": "The original text."
      },
      {
        "name": "start_num",
        "description": "Position of the first character to replace."
      },
      {
        "name": "num_chars",
        "description": "How many characters to replace."
      },
      {
        "name": "new_text",
        "description": "The replacement text."
      }
    ],
    "examples": [
      {
        "formula": "=REPLACE(\"abcdefghijk\",6,5,\"*\")",
        "result": "\"abcde*k\""
      },
      {
        "formula": "=REPLACE(\"2009\",3,2,\"10\")",
        "result": "\"2010\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "REPLACEB",
    "category": "Text",
    "summary": "Replaces part of a text string (bytes in double-byte languages).",
    "syntax": "REPLACEB(old_text, start_num, num_bytes, new_text)",
    "args": [
      {
        "name": "old_text",
        "description": "The original text."
      },
      {
        "name": "start_num",
        "description": "Starting position."
      },
      {
        "name": "num_bytes",
        "description": "How many to replace."
      },
      {
        "name": "new_text",
        "description": "The replacement text."
      }
    ],
    "examples": [
      {
        "formula": "=REPLACEB(\"abcdefghijk\",6,5,\"*\")",
        "result": "\"abcde*k\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "REPT",
    "category": "Text",
    "summary": "Repeats text a given number of times.",
    "syntax": "REPT(text, number_times)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      },
      {
        "name": "number_times",
        "description": "How many times to repeat."
      }
    ],
    "examples": [
      {
        "formula": "=REPT(\"*-\",3)",
        "result": "\"*-*-*-\""
      },
      {
        "formula": "=REPT(\"-\",10)",
        "result": "\"----------\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "RIGHT",
    "category": "Text",
