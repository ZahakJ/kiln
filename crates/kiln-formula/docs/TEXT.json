  {
    "name": "VALUE",
    "category": "Text",
    "summary": "Converts a text string that represents a number (or date or time) to a number.",
    "syntax": "VALUE(text)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      }
    ],
    "examples": [
      {
        "formula": "=VALUE(\"$1,000\")",
        "result": "1000"
      },
      {
        "formula": "=VALUE(\"16:48:00\")-VALUE(\"12:00:00\")",
        "result": "0.2"
      },
      {
        "formula": "=VALUE(\"12%\")",
        "result": "0.12"
      }
    ],
    "since": "2007"
  },
  {
    "name": "VALUETOTEXT",
    "category": "Text",
    "summary": "Returns text from any value.",
    "syntax": "VALUETOTEXT(value, [format])",
    "args": [
      {
        "name": "value",
        "description": "The value to convert."
      },
      {
        "name": "format",
        "description": "0 concise (default), 1 strict (text in quotes).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=VALUETOTEXT(TRUE)",
        "result": "\"TRUE\""
      },
      {
        "formula": "=VALUETOTEXT(\"Hello\",1)",
        "result": "\"\"\"Hello\"\"\""
      },
      {
        "formula": "=VALUETOTEXT(1234.01234)",
        "result": "\"1234.01234\""
      }
    ],
    "since": "2024"
  }
]
