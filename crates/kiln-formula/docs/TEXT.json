[
  {
    "name": "ARRAYTOTEXT",
    "category": "Text",
    "summary": "Returns an array of values as text.",
    "syntax": "ARRAYTOTEXT(array, [format])",
    "args": [
      {
        "name": "array",
        "description": "The array to convert."
      },
      {
        "name": "format",
        "description": "0 concise (default), 1 strict (with braces and quotes).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=ARRAYTOTEXT({1,\"a\";TRUE,2})",
        "result": "\"1, a, TRUE, 2\""
      },
      {
        "formula": "=ARRAYTOTEXT({1,\"a\";TRUE,2},1)",
        "result": "\"{1,\"\"a\"\";TRUE,2}\""
      }
    ],
    "since": "2024"
  },
  {
    "name": "CHAR",
    "category": "Text",
    "summary": "Returns the character for a code number (Windows-1252).",
    "syntax": "CHAR(number)",
    "args": [
      {
        "name": "number",
        "description": "A number from 1 to 255."
      }
    ],
    "examples": [
      {
        "formula": "=CHAR(65)",
        "result": "\"A\""
      },
      {
        "formula": "=CHAR(33)",
        "result": "\"!\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "CLEAN",
    "category": "Text",
    "summary": "Removes non-printable characters (codes 0–31) from text.",
    "syntax": "CLEAN(text)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      }
    ],
    "examples": [
      {
        "formula": "=CLEAN(CHAR(9)&\"Monthly report\"&CHAR(10))",
        "result": "\"Monthly report\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "CODE",
    "category": "Text",
    "summary": "Returns the code number of the first character in text (Windows-1252).",
    "syntax": "CODE(text)",
    "args": [
      {
        "name": "text",
        "description": "The text."
      }
    ],
    "examples": [
      {
        "formula": "=CODE(\"A\")",
        "result": "65"
      },
      {
        "formula": "=CODE(\"!\")",
        "result": "33"
      }
    ],
    "since": "2007"
  },
  {
    "name": "CONCAT",
    "category": "Text",
    "summary": "Joins text from several values and ranges.",
    "syntax": "CONCAT(text1, [text2], ...)",
    "args": [
      {
        "name": "text1",
        "description": "Text, a number or a range to join."
      },
      {
        "name": "text2",
        "description": "Further items.",
        "repeating": true,
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=CONCAT(\"a\",1,TRUE)",
        "result": "\"a1TRUE\""
      },
      {
        "formula": "=CONCAT({\"The\",\" \",\"sun\"})",
        "result": "\"The sun\""
      }
    ],
    "since": "2019"
  },
  {
    "name": "CONCATENATE",
    "category": "Text",
    "summary": "Joins several text strings into one.",
    "syntax": "CONCATENATE(text1, [text2], ...)",
    "args": [
      {
        "name": "text1",
        "description": "The first item to join."
      },
      {
        "name": "text2",
        "description": "Further items.",
        "repeating": true,
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=CONCATENATE(\"Stream population for \",\"brook trout\",\" is \",32,\"/mile.\")",
        "result": "\"Stream population for brook trout is 32/mile.\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "DOLLAR",
    "category": "Text",
    "summary": "Converts a number to text in currency format.",
    "syntax": "DOLLAR(number, [decimals])",
    "args": [
      {
        "name": "number",
        "description": "The number to format."
      },
      {
        "name": "decimals",
        "description": "Digits after the decimal point (default 2; negative rounds to the left).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=DOLLAR(1234.567,2)",
        "result": "\"$1,234.57\""
      },
      {
        "formula": "=DOLLAR(1234.567,-2)",
        "result": "\"$1,200\""
      },
      {
        "formula": "=DOLLAR(-1234.567,-2)",
        "result": "\"($1,200)\""
      },
      {
        "formula": "=DOLLAR(-0.123,4)",
        "result": "\"($0.1230)\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "EXACT",
    "category": "Text",
    "summary": "Checks whether two text strings are exactly the same (case-sensitive).",
    "syntax": "EXACT(text1, text2)",
    "args": [
      {
        "name": "text1",
        "description": "The first text."
      },
      {
        "name": "text2",
        "description": "The second text."
      }
    ],
    "examples": [
      {
        "formula": "=EXACT(\"word\",\"word\")",
        "result": "TRUE"
      },
      {
        "formula": "=EXACT(\"Word\",\"word\")",
        "result": "FALSE"
      }
    ],
    "since": "2007"
  },
  {
    "name": "FIND",
    "category": "Text",
    "summary": "Finds one text string within another (case-sensitive) and returns its position.",
    "syntax": "FIND(find_text, within_text, [start_num])",
    "args": [
      {
        "name": "find_text",
        "description": "The text to find."
      },
      {
        "name": "within_text",
        "description": "The text to search."
      },
      {
        "name": "start_num",
        "description": "The character to start at (default 1).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=FIND(\"M\",\"Miriam McGovern\")",
        "result": "1"
      },
      {
        "formula": "=FIND(\"m\",\"Miriam McGovern\")",
        "result": "6"
      },
      {
        "formula": "=FIND(\"M\",\"Miriam McGovern\",3)",
        "result": "8"
      }
    ],
    "since": "2007"
  },
  {
    "name": "FINDB",
    "category": "Text",
    "summary": "Finds one text string within another (byte positions in double-byte languages; same as FIND otherwise).",
    "syntax": "FINDB(find_text, within_text, [start_num])",
    "args": [
      {
        "name": "find_text",
        "description": "The text to find."
      },
      {
        "name": "within_text",
        "description": "The text to search."
      },
      {
        "name": "start_num",
        "description": "The character to start at.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=FINDB(\"c\",\"abc\")",
        "result": "3"
      }
    ],
    "since": "2007"
  },
  {
    "name": "FIXED",
    "category": "Text",
    "summary": "Formats a number as text with a fixed number of decimals.",
    "syntax": "FIXED(number, [decimals], [no_commas])",
    "args": [
      {
        "name": "number",
        "description": "The number to format."
      },
      {
        "name": "decimals",
        "description": "Digits after the decimal point (default 2).",
        "optional": true
      },
      {
        "name": "no_commas",
        "description": "TRUE to omit thousands separators.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=FIXED(1234.567,1)",
        "result": "\"1,234.6\""
      },
      {
        "formula": "=FIXED(1234.567,-1)",
        "result": "\"1,230\""
      },
      {
        "formula": "=FIXED(-1234.567,-1,TRUE)",
        "result": "\"-1230\""
      },
      {
        "formula": "=FIXED(44.332)",
        "result": "\"44.33\""
      }
    ],
    "since": "2007"
  },
  {
