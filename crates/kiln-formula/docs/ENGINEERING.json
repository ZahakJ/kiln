  {
    "name": "COMPLEX",
    "category": "Engineering",
    "summary": "Converts real and imaginary coefficients into a complex number.",
    "syntax": "COMPLEX(real_num, i_num, [suffix])",
    "args": [
      {
        "name": "real_num",
        "description": "The real coefficient."
      },
      {
        "name": "i_num",
        "description": "The imaginary coefficient."
      },
      {
        "name": "suffix",
        "description": "\"i\" (default) or \"j\".",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=COMPLEX(3,4)",
        "result": "\"3+4i\""
      },
      {
        "formula": "=COMPLEX(3,4,\"j\")",
        "result": "\"3+4j\""
      },
      {
        "formula": "=COMPLEX(0,1)",
        "result": "\"i\""
      },
      {
        "formula": "=COMPLEX(1,0)",
        "result": "\"1\""
      }
    ],
    "since": "2007"
  },
  {
    "name": "CONVERT",
    "category": "Engineering",
    "summary": "Converts a number from one measurement system to another.",
    "syntax": "CONVERT(number, from_unit, to_unit)",
    "args": [
      {
        "name": "number",
        "description": "The value to convert."
      },
      {
        "name": "from_unit",
        "description": "The unit of number (e.g. \"lbm\", \"mi\", \"F\", \"kWh\")."
      },
      {
        "name": "to_unit",
        "description": "The unit for the result."
      }
    ],
    "examples": [
      {
        "formula": "=CONVERT(1,\"lbm\",\"kg\")",
        "result": "0.453592"
      },
      {
        "formula": "=CONVERT(68,\"F\",\"C\")",
        "result": "20"
      },
      {
        "formula": "=CONVERT(2.5,\"ft\",\"sec\")",
        "result": "#N/A"
      },
      {
        "formula": "=CONVERT(100,\"ft2\",\"m2\")",
        "result": "9.290304"
      },
      {
        "formula": "=CONVERT(1,\"kbyte\",\"bit\")",
        "result": "8000"
      }
    ],
    "since": "2007"
  },
