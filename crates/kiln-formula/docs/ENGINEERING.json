  {
    "name": "BIN2DEC",
    "category": "Engineering",
    "summary": "Converts a binary number to decimal.",
    "syntax": "BIN2DEC(number)",
    "args": [
      {
        "name": "number",
        "description": "Up to 10 binary digits; the 10th bit is the sign (two's complement)."
      }
    ],
    "examples": [
      {
        "formula": "=BIN2DEC(1100100)",
        "result": "100"
      },
      {
        "formula": "=BIN2DEC(1111111111)",
        "result": "-1"
      }
    ],
    "since": "2007"
  },
  {
