    "summary": "Returns 1 if a number is greater than or equal to a threshold, otherwise 0.",
    "syntax": "GESTEP(number, [step])",
    "args": [
      {
        "name": "number",
        "description": "The value to test."
      },
      {
        "name": "step",
        "description": "The threshold (default 0).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=GESTEP(5,4)",
        "result": "1"
      },
      {
        "formula": "=GESTEP(5,5)",
        "result": "1"
      },
      {
        "formula": "=GESTEP(-4,-5)",
        "result": "1"
      },
      {
        "formula": "=GESTEP(-1)",
        "result": "0"
      }
    ],
    "since": "2007"
