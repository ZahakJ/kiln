[
  {
    "name": "ENCODEURL",
    "category": "Web",
    "summary": "Returns a URL-encoded (percent-encoded) string.",
    "syntax": "ENCODEURL(text)",
    "args": [
      {
        "name": "text",
        "description": "The text to encode."
      }
    ],
    "examples": [
      {
        "formula": "=ENCODEURL(\"http://contoso.sharepoint.com/Finance/Profit and Loss Statement.xlsx\")",
        "result": "\"http%3A%2F%2Fcontoso.sharepoint.com%2FFinance%2FProfit%20and%20Loss%20Statement.xlsx\""
      }
    ],
    "since": "2013"
  }
]
