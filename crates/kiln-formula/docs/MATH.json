  {
    "name": "AGGREGATE",
    "category": "Math & Trig",
    "summary": "Returns an aggregate (sum, average, count, large…) of a list, optionally ignoring hidden rows, errors and nested SUBTOTAL/AGGREGATE results.",
    "syntax": "AGGREGATE(function_num, options, ref1, [ref2], ...)",
    "args": [
      {
        "name": "function_num",
        "description": "1–19: AVERAGE, COUNT, COUNTA, MAX, MIN, PRODUCT, STDEV.S, STDEV.P, SUM, VAR.S, VAR.P, MEDIAN, MODE.SNGL, LARGE, SMALL, PERCENTILE.INC, QUARTILE.INC, PERCENTILE.EXC, QUARTILE.EXC."
      },
      {
        "name": "options",
        "description": "0–7: what to ignore (6 ignores error values; 5 hidden rows; 7 both)."
      },
      {
        "name": "ref1",
        "description": "The first range or array."
      },
      {
        "name": "ref2",
        "description": "Further ranges, or k for functions 14–19.",
        "repeating": true,
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=AGGREGATE(9,6,{1,2,#N/A,4})",
        "result": "7"
      },
      {
        "formula": "=AGGREGATE(14,6,{3,#DIV/0!,9,5},2)",
        "result": "5"
      }
    ],
    "since": "2010"
  },
