  {
    "name": "BASE",
    "category": "Math & Trig",
    "summary": "Converts a number into a text representation in another base (radix).",
    "syntax": "BASE(number, radix, [min_length])",
    "args": [
      {
        "name": "number",
        "description": "A whole number from 0 to 2^53."
      },
      {
        "name": "radix",
        "description": "The base, from 2 to 36."
      },
      {
        "name": "min_length",
        "description": "Minimum length of the result (padded with zeros).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=BASE(7,2)",
        "result": "\"111\""
      },
      {
        "formula": "=BASE(100,16)",
        "result": "\"64\""
      },
      {
        "formula": "=BASE(15,2,10)",
        "result": "\"0000001111\""
      }
    ],
    "since": "2013"
