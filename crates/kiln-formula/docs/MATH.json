  {
    "name": "CEILING.MATH",
    "category": "Math & Trig",
    "summary": "Rounds a number up to the nearest integer or multiple of significance.",
    "syntax": "CEILING.MATH(number, [significance], [mode])",
    "args": [
      {
        "name": "number",
        "description": "A real number."
      },
      {
        "name": "significance",
        "description": "The multiple to round to (default 1).",
        "optional": true
      },
      {
        "name": "mode",
        "description": "For negative numbers, non-zero rounds away from zero.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=CEILING.MATH(24.3,5)",
        "result": "25"
      },
      {
        "formula": "=CEILING.MATH(6.7)",
        "result": "7"
      },
      {
        "formula": "=CEILING.MATH(-8.1,2)",
        "result": "-8"
      },
      {
        "formula": "=CEILING.MATH(-5.5,2,-1)",
        "result": "-6"
      }
    ],
    "since": "2013"
  },
