{
  "name": "@kiln/editor-deck",
  "version": "0.1.0",
  "private": true,
  "description": "Kiln Deck's editor views: the slide stage (canvas tiles, selection handles, smart guides, text editing), the thumbnail rail with sections, the notes pane, the status bar, the Slide Size, Format Background and other dialogs. Presentation only; every edit is a core command.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kiln/commands": "workspace:*",
    "@kiln/i18n": "workspace:*",
    "@kiln/protocol": "workspace:*",
    "@kiln/surface": "workspace:*",
    "@kiln/ui-kit": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
