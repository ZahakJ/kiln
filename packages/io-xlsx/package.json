{
  "name": "@officina/io-xlsx",
  "version": "0.1.0",
  "private": true,
  "description": "Reads and writes .xlsx (and .xltx/.xlsm) to and from the Tabula workbook model, plus CSV, TSV and JSON import/export.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@officina/ooxml": "workspace:*",
    "@officina/sheet-model": "workspace:*",
    "papaparse": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/papaparse": "catalog:",
    "exceljs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
