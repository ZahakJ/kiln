{
  "name": "@officina/io-pptx",
  "version": "0.1.0",
  "private": true,
  "description": "Reads and writes .pptx (and .potx/.pptm) to and from the Scena presentation model.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
