{
  "name": "@officina/io-odf",
  "version": "0.1.0",
  "private": true,
  "description": "Imports and exports OpenDocument files (.odt, .ods, .odp) to and from the Officina models.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@officina/deck-model": "workspace:*",
    "@officina/doc-model": "workspace:*",
    "@officina/sheet-model": "workspace:*",
    "fast-xml-parser": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
