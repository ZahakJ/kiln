{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZahakJ/kiln/parity/schema.json",
  "title": "Kiln parity tracker",
  "description": "Shape of parity/parity.json (the root), parity/functions.json, parity/corpus.json and parity/releases/<tag>.json (PLAN.md §7.2). cargo xtask parity validates every file against this schema; it supports the keywords used here and fails on any other.",
  "type": "object",
  "required": ["version", "updated", "weights", "rows"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "updated": { "$ref": "#/$defs/date" },
    "weights": {
      "type": "object",
      "required": ["tier", "status"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "object",
          "required": ["critical", "commonly-missed", "niche"],
          "additionalProperties": false,
          "properties": {
            "critical": { "$ref": "#/$defs/weight" },
            "commonly-missed": { "$ref": "#/$defs/weight" },
            "niche": { "$ref": "#/$defs/weight" }
          }
        },
        "status": {
          "type": "object",
          "required": ["missing", "partial", "done", "better"],
          "additionalProperties": false,
          "properties": {
            "missing": { "type": "number", "minimum": 0, "maximum": 1 },
            "partial": { "type": "number", "minimum": 0, "maximum": 1 },
            "done": { "type": "number", "minimum": 0, "maximum": 1 },
            "better": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "weight": { "type": "number", "minimum": 0, "exclusiveMaximum": 100 },
    "app": { "enum": ["write", "grid", "deck", "notes", "suite"] },
    "tier": { "enum": ["critical", "commonly-missed", "niche"] },
    "priority": { "enum": ["P0", "P1", "P2", "out"] },
    "status": { "enum": ["missing", "partial", "done", "better"] },
    "text": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
    "verifyId": {
      "description": "A verification id (PLAN.md §7.2); cargo xtask parity --verify resolves and runs it.",
      "type": "string",
      "anyOf": [
        {
          "description": "Playwright test: e2e/specs/<spec>.spec.ts, test title slug",
          "pattern": "^e2e:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9-]*$"
        },
        {
          "description": "Rust test (crates/<crate> or xtask, nextest filter) or TypeScript test (packages/<package> or apps/<app>, vitest -t)",
          "pattern": "^unit:[a-z0-9][a-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_./-]*$"
        },
        {
          "description": "Formula conformance CSV under conformance/, optionally one function",
          "pattern": "^conformance:[a-z0-9][a-z0-9-]*\\.csv(#[A-Z][A-Z0-9.]*)?$"
        },
        {
          "description": "Fidelity metric from docs/qa/fidelity.md",
          "pattern": "^fidelity:(docx|xlsx|pptx|odt|ods|odp):[a-z][a-z_]*>=(0|1)(\\.[0-9]+)?$"
        },
        {
          "description": "Manual check documented under docs/qa (niche rows only)",
          "pattern": "^manual:docs/qa/[A-Za-z0-9_./-]+\\.md#[a-z0-9][a-z0-9-]*$"
        }
      ]
    },
    "automatedVerifyId": { "type": "string", "pattern": "^(e2e|unit|conformance|fidelity):" },
    "row": {
      "type": "object",
      "required": [
        "id",
        "app",
        "area",
        "feature",
        "office",
        "tier",
        "priority",
        "status",
        "wp",
        "verify",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(write|grid|deck|notes|suite)(\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$",
          "maxLength": 120
        },
        "app": { "$ref": "#/$defs/app" },
        "area": { "$ref": "#/$defs/text" },
        "feature": { "$ref": "#/$defs/text" },
        "office": { "$ref": "#/$defs/text" },
        "tier": { "$ref": "#/$defs/tier" },
        "priority": { "$ref": "#/$defs/priority" },
        "status": { "$ref": "#/$defs/status" },
        "wp": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^WP-[0-9]{2,3}$" }] },
        "verify": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/verifyId" } },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "description": "critical rows are P0 (§7.1)",
          "if": { "properties": { "tier": { "const": "critical" } } },
          "then": { "properties": { "priority": { "const": "P0" } } }
        },
        {
          "description": "commonly-missed rows are P0 or P1 (§7.1)",
          "if": { "properties": { "tier": { "const": "commonly-missed" } } },
          "then": { "properties": { "priority": { "enum": ["P0", "P1"] } } }
        },
        {
          "description": "niche rows are P2 or out (§7.1)",
          "if": { "properties": { "tier": { "const": "niche" } } },
          "then": { "properties": { "priority": { "enum": ["P2", "out"] } } }
        },
        {
          "description": "out-of-scope rows stay missing and are delivered by no work package",
          "if": { "properties": { "priority": { "const": "out" } } },
          "then": { "properties": { "status": { "const": "missing" }, "wp": { "type": "null" } } }
        },
        {
          "description": "done and better rows need at least one automated (non-manual) verify id (§7.2)",
          "if": { "properties": { "status": { "enum": ["done", "better"] } } },
          "then": { "properties": { "verify": { "contains": { "$ref": "#/$defs/automatedVerifyId" } } } }
        },
        {
          "description": "partial rows name at least one automated verify id whose target exists",
          "if": { "properties": { "status": { "const": "partial" } } },
          "then": { "properties": { "verify": { "contains": { "$ref": "#/$defs/automatedVerifyId" } } } }
        },
        {
          "description": "better rows state in notes what is better than Office (§7.2)",
          "if": { "properties": { "status": { "const": "better" } } },
          "then": { "properties": { "notes": { "minLength": 12 } } }
        },
        {
          "description": "rows that exist to be better than Office (office \"—\") are commonly-missed and can only be better (§7.2)",
          "if": { "properties": { "office": { "const": "—" } } },
          "then": {
            "properties": {
              "tier": { "const": "commonly-missed" },
              "status": { "enum": ["missing", "partial", "better"] },
              "notes": { "minLength": 12 }
            }
          }
        },
        {
          "description": "manual verify ids are allowed on niche rows only (§7.2)",
          "if": { "properties": { "tier": { "enum": ["critical", "commonly-missed"] } } },
          "then": { "properties": { "verify": { "items": { "not": { "pattern": "^manual:" } } } } }
        }
      ]
    },
    "functionEntry": {
      "type": "object",
      "required": ["name", "family", "since", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(\\.[A-Z0-9]+)*$" },
        "family": {
          "enum": [
            "math",
            "statistical",
            "financial",
            "logical",
            "text",
            "date-time",
            "lookup",
            "information",
            "engineering",
            "database",
            "compatibility",
            "web",
            "cube",
            "add-in"
          ]
        },
        "since": {
          "description": "Excel version that introduced it; 2007 means 2007 or earlier, 365 means Microsoft 365 only",
          "enum": ["2007", "2010", "2013", "2016", "2019", "2021", "2024", "365"]
        },
        "status": { "enum": ["planned", "done", "out"] },
        "notes": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "description": "out functions say why in notes",
          "if": { "properties": { "status": { "const": "out" } } },
          "then": { "required": ["notes"] }
        }
      ]
    },
    "functionsFile": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/functionEntry" } },
    "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
    "corpusEntry": {
      "type": "object",
      "required": ["file", "checks"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(docx|xlsx|pptx|odf)/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+\\.(docx|docm|xlsx|xlsm|pptx|pptm|odt|ods|odp)$"
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "structural": { "$ref": "#/$defs/ratio" },
            "text": { "$ref": "#/$defs/ratio" },
            "visual": { "$ref": "#/$defs/ratio" },
            "values": { "$ref": "#/$defs/ratio" },
            "formulas": { "$ref": "#/$defs/ratio" },
            "oracle_opens": { "type": "boolean" },
            "byte_identical_untouched": { "type": "boolean" }
          }
        },
        "rows": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "corpusFile": {
      "type": "object",
      "required": ["version", "files"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "version": { "const": 1 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/corpusEntry" } }
      }
    },
    "snapshotFile": {
      "description": "Statuses at a release tag, written by cargo xtask parity --snapshot <tag>; PARITY.md lists flips since the newest one.",
      "type": "object",
      "required": ["tag", "date", "score", "statuses"],
      "additionalProperties": false,
      "properties": {
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$" },
        "date": { "$ref": "#/$defs/date" },
        "score": { "$ref": "#/$defs/ratio" },
        "statuses": {
          "type": "object",
          "propertyNames": { "pattern": "^(write|grid|deck|notes|suite)\\." },
          "additionalProperties": { "$ref": "#/$defs/status" }
        }
      }
    }
  }
}
