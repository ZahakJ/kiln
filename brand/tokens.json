{
  "$schema": "kiln-tokens/1",
  "name": "Kiln",
  "rule": "Each app burns its own colour; ember belongs to the suite (Home, brand moments, focus of the suite chrome).",
  "color": {
    "light": {
      "bg": "#F6EFE6",
      "panel": "#FFFCF7",
      "raised": "#FFFFFF",
      "sunken": "#EEE3D5",
      "page": "#FFFFFF",
      "canvas": "#EDE4D8",
      "fg": "#2B1C14",
      "muted": "#6B5547",
      "faint": "#8F7A6A",
      "line": "#E4D6C4",
      "lineStrong": "#CDB8A0",
      "ember": "#C2481C",
      "emberText": "#B2431A",
      "onEmber": "#FFF7EE",
      "selection": "#FFD9B8",
      "focus": "#C2481C",
      "danger": "#B42318",
      "success": "#17714E",
      "warning": "#87590A"
    },
    "dark": {
      "bg": "#17110E",
      "panel": "#201813",
      "raised": "#2A201A",
      "sunken": "#110C0A",
      "page": "#221A15",
      "canvas": "#120D0B",
      "fg": "#F5EBDD",
      "muted": "#B8A392",
      "faint": "#8C7867",
      "line": "#372A22",
      "lineStrong": "#4B3A2F",
      "ember": "#F2804E",
      "emberText": "#F7976B",
      "onEmber": "#1C0D06",
      "selection": "#5A2A14",
      "focus": "#F7976B",
      "danger": "#FF8A7A",
      "success": "#6FD0A6",
      "warning": "#F2C35C"
    },
    "product": {
      "write": {
        "name": "Kiln Write",
        "replaces": "Word",
        "glaze": "cobalt",
        "fill": "#3159C6",
        "solid": "#2D4FB5",
        "onSolid": "#FFFFFF",
        "textLight": "#2D4FB5",
        "textDark": "#97AEF4",
        "tintLight": "#E7ECFA",
        "tintDark": "#1C2440",
        "icon": [
          "#4C72E0",
          "#2748AE"
        ]
      },
      "grid": {
        "name": "Kiln Grid",
        "replaces": "Excel",
        "glaze": "jade",
        "fill": "#1D8A60",
        "solid": "#17714E",
        "onSolid": "#FFFFFF",
        "textLight": "#17714E",
        "textDark": "#6FD0A6",
        "tintLight": "#E2F2EA",
        "tintDark": "#142C22",
        "icon": [
          "#30A577",
          "#167150"
        ]
      },
      "deck": {
        "name": "Kiln Deck",
        "replaces": "PowerPoint",
        "glaze": "ember",
        "fill": "#E05A27",
        "solid": "#E05A27",
        "onSolid": "#1C0D06",
        "textLight": "#B2431A",
        "textDark": "#F7976B",
        "tintLight": "#FBE8DE",
        "tintDark": "#36190E",
        "icon": [
          "#F47B45",
          "#CC4A1E"
        ]
      },
      "notes": {
        "name": "Kiln Notes",
        "replaces": "OneNote",
        "glaze": "saffron",
        "fill": "#E3A126",
        "solid": "#E8A82C",
        "onSolid": "#1C0D06",
        "textLight": "#87590A",
        "textDark": "#F2C35C",
        "tintLight": "#FAF0D9",
        "tintDark": "#30230C",
        "icon": [
          "#F5B73F",
          "#CF8A12"
        ]
      },
      "home": {
        "name": "Kiln Home",
        "replaces": "Office start screen",
        "glaze": "tenmoku",
        "fill": "#2E1C13",
        "solid": "#C2481C",
        "onSolid": "#FFF7EE",
        "textLight": "#B2431A",
        "textDark": "#F7976B",
        "tintLight": "#F6E6DA",
        "tintDark": "#2A1A12",
        "icon": [
          "#54321F",
          "#21140D"
        ]
      }
    },
    "neutral": {
      "bone": "#FFF6E8",
      "bisque": "#EADBC6",
      "terracotta": "#B4462A",
      "clay": "#7A4A33",
      "tenmoku": "#2A1A12",
      "soot": "#17110E",
      "char": "#0F0805"
    },
    "fire": {
      "core": "#FFF3D6",
      "flame": "#FFB547",
      "ember": "#FF6A26",
      "tongue": "#D93D12",
      "glow": "#FF7A2A"
    }
  },
  "font": {
    "display": {
      "family": "Fraunces",
      "use": "wordmark, headlines, app names, document headings (Kiln theme)",
      "settings": {
        "wght": 800,
        "SOFT": 40,
        "WONK": 0,
        "opsz": 72
      }
    },
    "ui": {
      "family": "Figtree",
      "use": "all interface text, banner copy",
      "weights": [
        400,
        500,
        600,
        700,
        800
      ]
    },
    "docBody": {
      "family": "Figtree",
      "use": "default body text for new documents (neutral, Aptos/Calibri-like)",
      "fallbackForOffice": "Carlito (metric-compatible with Calibri), Caladea (with Cambria)"
    },
    "stack": {
      "display": "'Fraunces', 'Iowan Old Style', Georgia, serif",
      "ui": "'Figtree', 'Segoe UI Variable', 'Segoe UI', system-ui, -apple-system, 'Noto Sans', sans-serif"
    },
    "size": {
      "xs": 11,
      "sm": 12,
      "base": 13,
      "md": 14,
      "lg": 16,
      "xl": 20,
      "2xl": 26,
      "3xl": 34,
      "hero": 48
    }
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "pill": 999,
    "archRatio": 0.5
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "shadow": {
    "light": {
      "1": "0 1px 2px rgba(60,30,10,.06), 0 1px 1px rgba(60,30,10,.04)",
      "2": "0 2px 6px rgba(60,30,10,.07), 0 8px 24px rgba(60,30,10,.06)",
      "page": "0 1px 2px rgba(60,30,10,.08), 0 12px 40px rgba(60,30,10,.10)"
    },
    "dark": {
      "1": "0 1px 2px rgba(0,0,0,.4)",
      "2": "0 4px 16px rgba(0,0,0,.45)",
      "page": "0 30px 80px -20px rgba(255,106,38,.22), 0 2px 10px rgba(0,0,0,.5)"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "320ms",
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "flicker": "spark flicker on autosave: 2 frames, 600ms, never loops"
  },
  "contrast": {
    "light.fg on bg": 14.39,
    "light.fg on panel": 16.04,
    "light.fg on page": 16.42,
    "light.muted on bg": 6.1,
    "light.muted on panel": 6.8,
    "light.muted on page": 6.96,
    "light.emberText on bg": 4.96,
    "light.emberText on panel": 5.53,
    "light.emberText on page": 5.66,
    "light.onEmber on ember": 4.67,
    "light.write text on bg": 6.35,
    "light.write text on panel": 7.08,
    "light.write text on tint": 6.14,
    "light.grid text on bg": 5.25,
    "light.grid text on panel": 5.85,
    "light.grid text on tint": 5.17,
    "light.deck text on bg": 4.96,
    "light.deck text on panel": 5.53,
    "light.deck text on tint": 4.77,
    "light.notes text on bg": 5.31,
    "light.notes text on panel": 5.92,
    "light.notes text on tint": 5.35,
    "light.home text on bg": 4.96,
    "light.home text on panel": 5.53,
    "light.home text on tint": 4.65,
    "dark.fg on bg": 15.86,
    "dark.fg on panel": 14.82,
    "dark.fg on page": 14.52,
    "dark.muted on bg": 7.74,
    "dark.muted on panel": 7.23,
    "dark.muted on page": 7.09,
    "dark.emberText on bg": 8.54,
    "dark.emberText on panel": 7.99,
    "dark.emberText on page": 7.82,
    "dark.onEmber on ember": 7.19,
    "dark.write text on bg": 8.62,
    "dark.write text on panel": 8.05,
    "dark.write text on tint": 7.03,
    "dark.grid text on bg": 10.02,
    "dark.grid text on panel": 9.36,
    "dark.grid text on tint": 7.96,
    "dark.deck text on bg": 8.54,
    "dark.deck text on panel": 7.99,
    "dark.deck text on tint": 7.37,
    "dark.notes text on bg": 11.34,
    "dark.notes text on panel": 10.6,
    "dark.notes text on tint": 9.29,
    "dark.home text on bg": 8.54,
    "dark.home text on panel": 7.99,
    "dark.home text on tint": 7.64,
    "write onSolid on solid": 7.25,
