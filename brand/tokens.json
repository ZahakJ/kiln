    "deck onSolid on solid": 5.1,
    "notes onSolid on solid": 9.07,
    "home onSolid on solid": 4.67
  },
  "contrastNote": "Every text pair listed passes WCAG 2.1 AA (4.5:1). 'fill' and 'icon' colours are for shapes, never for text."
}