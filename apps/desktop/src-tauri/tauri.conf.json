{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiln",
  "mainBinaryName": "kiln",
  "version": "0.1.0",
  "identifier": "io.github.zahakj.kiln",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @kiln/web dev",
    "beforeBuildCommand": "pnpm --filter @kiln/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiln",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi", "dmg"],
    "category": "Productivity",
    "shortDescription": "Documents, spreadsheets and slides",
    "longDescription": "Kiln is an open-source office suite: Kiln Write, Kiln Grid, Kiln Deck and Kiln Notes.",
    "copyright": "Copyright the Kiln contributors. AGPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
