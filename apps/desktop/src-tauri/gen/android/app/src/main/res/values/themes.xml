<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Kiln's theme: the window, the splash screen and the system bars take the colour of Kiln
      Home's title bar until the page sets them (light or dark, from the design tokens).
    -->
    <style name="Theme.kiln_desktop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/kiln_ember</item>
        <item name="colorOnPrimary">@color/kiln_on_ember</item>
        <item name="android:windowBackground">@color/kiln_window</item>
        <item name="android:statusBarColor">@color/kiln_window</item>
        <item name="android:navigationBarColor">@color/kiln_window</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
