{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the Kiln IPC commands (PLAN.md §3.5) and the plugins the host needs (files, dialogs, links, PDFs to print from the temporary folder, process). Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-kiln-open",
    "allow-kiln-new",
    "allow-kiln-execute",
    "allow-kiln-query",
    "allow-kiln-viewport",
    "allow-kiln-frame",
    "allow-kiln-a11y",
    "allow-kiln-subscribe",
    "allow-kiln-host-reply",
    "allow-kiln-startup-probe",
    "fs:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/kiln-print/**" }]
    },
    "process:default"
  ]
}
