{
  "name": "@kiln/web",
  "version": "0.1.0",
  "private": true,
  "description": "Kiln web app: the Vite + React shell that hosts the WebAssembly core and that the Tauri shell loads.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
