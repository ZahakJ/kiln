{
  "id": "./",
  "name": "Kiln",
  "short_name": "Kiln",
  "description": "Where work gets made. Kiln Write, Grid and Deck: documents, spreadsheets and presentations that open your Word, Excel and PowerPoint files as they are.",
  "lang": "en",
  "dir": "auto",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F6EFE6",
  "theme_color": "#F6EFE6",
  "categories": ["productivity", "business", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/home-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Kiln Home: recent files, templates and the three apps"
    },
    {
      "src": "screenshots/grid-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Kiln Grid with a workbook open"
    },
    {
      "src": "screenshots/write-wide-dark.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Kiln Write in the dark theme"
    },
    {
      "src": "screenshots/home-narrow.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Kiln Home on a phone"
    },
    {
      "src": "screenshots/deck-narrow-dark.png",
      "sizes": "412x915",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Kiln Deck on a phone, dark theme"
    }
  ],
  "shortcuts": [
    {
      "name": "New document",
      "short_name": "Write",
      "url": "./#/write",
      "icons": [
        {
          "src": "icons/write-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New workbook",
      "short_name": "Grid",
      "url": "./#/grid",
      "icons": [
        {
          "src": "icons/grid-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New presentation",
      "short_name": "Deck",
      "url": "./#/deck",
      "icons": [
        {
          "src": "icons/deck-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Word document",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.template": [".dotx"],
        "application/vnd.ms-word.document.macroEnabled.12": [".docm"],
        "application/vnd.ms-word.template.macroEnabled.12": [".dotm"],
        "application/x-kiln-write": [".kwrite"]
      },
      "icons": [
        {
          "src": "icons/write-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "name": "Excel workbook",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.template": [".xltx"],
        "application/vnd.ms-excel.sheet.macroEnabled.12": [".xlsm"],
        "text/csv": [".csv"],
        "application/x-kiln-grid": [".kgrid"]
      },
      "icons": [
        {
          "src": "icons/grid-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "name": "PowerPoint presentation",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.openxmlformats-officedocument.presentationml.template": [".potx"],
        "application/vnd.openxmlformats-officedocument.presentationml.slideshow": [".ppsx"],
        "application/vnd.ms-powerpoint.presentation.macroEnabled.12": [".pptm"],
        "application/x-kiln-deck": [".kdeck"]
      },
      "icons": [
        {
          "src": "icons/deck-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    },
    {
      "action": "./",
      "name": "Text document",
      "accept": {
        "text/plain": [".txt"],
        "text/markdown": [".md"]
      },
      "icons": [
        {
          "src": "icons/write-256.png",
          "sizes": "256x256",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.template",
            ".dotx",
            "application/vnd.ms-word.document.macroEnabled.12",
            ".docm",
            "application/vnd.ms-word.template.macroEnabled.12",
            ".dotm",
            "application/x-kiln-write",
            ".kwrite",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.template",
            ".xltx",
            "application/vnd.ms-excel.sheet.macroEnabled.12",
            ".xlsm",
            "text/csv",
            ".csv",
            "application/x-kiln-grid",
            ".kgrid",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            ".pptx",
            "application/vnd.openxmlformats-officedocument.presentationml.template",
            ".potx",
            "application/vnd.openxmlformats-officedocument.presentationml.slideshow",
            ".ppsx",
            "application/vnd.ms-powerpoint.presentation.macroEnabled.12",
            ".pptm",
            "application/x-kiln-deck",
            ".kdeck",
            "text/plain",
            ".txt",
            "text/markdown",
            ".md"
          ]
        }
      ]
    }
  }
}
