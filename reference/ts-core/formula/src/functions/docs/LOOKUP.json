  },
  {
    "name": "XLOOKUP",
    "category": "Lookup & Reference",
    "summary": "Searches a range or array and returns the matching item from another range or array.",
    "syntax": "XLOOKUP(lookup_value, lookup_array, return_array, [if_not_found], [match_mode], [search_mode])",
    "args": [
      {
        "name": "lookup_value",
        "description": "The value to search for."
      },
      {
        "name": "lookup_array",
        "description": "The row or column to search."
      },
      {
        "name": "return_array",
        "description": "The range or array to return from."
      },
      {
        "name": "if_not_found",
        "description": "Returned when nothing matches (default #N/A).",
        "optional": true
      },
      {
        "name": "match_mode",
        "description": "0 exact (default), -1 exact or next smaller, 1 exact or next larger, 2 wildcard.",
        "optional": true
      },
      {
        "name": "search_mode",
        "description": "1 first to last (default), -1 last to first, 2 binary ascending, -2 binary descending.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=XLOOKUP(5,{1,3,5},{\"a\",\"b\",\"c\"})",
        "result": "\"c\""
      },
      {
        "formula": "=XLOOKUP(4,{1,3,5},{\"a\",\"b\",\"c\"},\"none\",-1)",
        "result": "\"b\""
      },
      {
        "formula": "=XLOOKUP(\"x\",{\"a\",\"b\"},{1,2},\"none\")",
        "result": "\"none\""
      }
    ],
    "since": "2021"
  },
  {
    "name": "XMATCH",
    "category": "Lookup & Reference",
    "summary": "Returns the relative position of an item in a row or column.",
    "syntax": "XMATCH(lookup_value, lookup_array, [match_mode], [search_mode])",
    "args": [
      {
        "name": "lookup_value",
        "description": "The value to find."
      },
      {
        "name": "lookup_array",
        "description": "The row or column to search."
      },
      {
        "name": "match_mode",
        "description": "0 exact (default), -1 next smaller, 1 next larger, 2 wildcard.",
        "optional": true
      },
      {
        "name": "search_mode",
        "description": "1 first to last (default), -1 last to first, 2/-2 binary search.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=XMATCH(\"Gra?e\",{\"Apple\",\"Grape\",\"Pear\",\"Banana\",\"Cherry\"},2)",
        "result": "2"
      },
      {
        "formula": "=XMATCH(35000,{5000,20000,30000,40000,50000},1)",
        "result": "4"
      }
    ],
    "since": "2021"
  }
