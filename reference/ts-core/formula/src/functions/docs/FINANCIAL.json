[
  {
    "name": "ACCRINT",
    "category": "Financial",
    "summary": "Returns the accrued interest for a security that pays periodic interest.",
    "syntax": "ACCRINT(issue, first_interest, settlement, rate, par, frequency, [basis], [calc_method])",
    "args": [
      {
        "name": "issue",
        "description": "The issue date."
      },
      {
        "name": "first_interest",
        "description": "The first interest date."
      },
      {
        "name": "settlement",
        "description": "The settlement date."
      },
      {
        "name": "rate",
        "description": "The annual coupon rate."
      },
      {
        "name": "par",
        "description": "The par value."
      },
      {
        "name": "frequency",
        "description": "Coupon payments per year: 1 annual, 2 semiannual, 4 quarterly."
      },
      {
        "name": "basis",
        "description": "Day count basis: 0 US 30/360 (default), 1 actual/actual, 2 actual/360, 3 actual/365, 4 European 30/360.",
        "optional": true
      },
      {
        "name": "calc_method",
        "description": "TRUE (default) accrues from issue to settlement.",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=ACCRINT(DATE(2008,3,1),DATE(2008,8,31),DATE(2008,5,1),0.1,1000,2,0)",
        "result": "16.66666667"
      }
    ],
    "since": "2007"
  },
