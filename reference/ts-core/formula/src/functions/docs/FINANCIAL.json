      },
      {
        "name": "life",
        "description": "The number of periods."
      },
      {
        "name": "period",
        "description": "The period to calculate."
      },
      {
        "name": "month",
        "description": "Months in the first year (default 12).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=DB(1000000,100000,6,1,7)",
        "result": "186083.3333"
