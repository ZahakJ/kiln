        "name": "nper",
        "description": "The total number of payment periods."
      },
      {
        "name": "pv",
        "description": "The present value (principal)."
      },
      {
        "name": "start_period",
        "description": "The first period."
      },
      {
        "name": "end_period",
        "description": "The last period."
      },
      {
        "name": "type",
        "description": "0 end of period, 1 beginning."
      }
    ],
    "examples": [
      {
        "formula": "=CUMIPMT(0.09/12,30*12,125000,13,24,0)",
        "result": "-11135.23213"
