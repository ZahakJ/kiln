  {
    "name": "BETADIST",
    "category": "Compatibility",
    "summary": "Returns the cumulative beta distribution. Use BETA.DIST in new workbooks.",
    "syntax": "BETADIST(x, alpha, beta, [A], [B])",
    "args": [
      {
        "name": "x",
        "description": "The value at which to evaluate the distribution."
      },
      {
        "name": "alpha",
        "description": "A parameter."
      },
      {
        "name": "beta",
        "description": "A parameter."
      },
      {
        "name": "A",
        "description": "Lower bound (default 0).",
        "optional": true
      },
      {
        "name": "B",
        "description": "Upper bound (default 1).",
        "optional": true
      }
    ],
    "examples": [
      {
        "formula": "=BETADIST(2,8,10,1,3)",
        "result": "0.685470581"
      }
    ],
    "since": "2007"
  },
